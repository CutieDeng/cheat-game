;; 庄园书房案 —— MVP 场景
;; 时间写作 HHMM，加载时转为分钟。命题 (at 人 地点 起 止) 表示 [起, 止) 期间位于该地点。
((title "庄园书房案")
 (briefing "被害人约 20:10 在书房遇害。书房外的走廊里发现一个烟头。三名在场者：管家、厨师、园丁。找出凶手。")
 (window 1930 2100)
 (slots (1930 2000) (2000 2030) (2030 2100))
 (persons (V "被害人") (E1 "管家") (E2 "厨师") (E3 "园丁"))
 (locations (L1 "书房") (L2 "厨房") (L3 "走廊") (L4 "花园"))
 (npcs E1 E2 E3)
 (culprit E1)
 ;; 作案地点与时段（公开信息：侦探知道死者约 20:10 在书房遇害）。
 ;; 凶手自己承认在此时段出现在此地点，即可定罪。
 (crime L1 2005 2020)

 (truth
  (at V  L1 1930 2100)
  (at E1 L2 1930 2000) (at E1 L3 2000 2005) (at E1 L1 2005 2020) (at E1 L3 2020 2025) (at E1 L2 2025 2100)
  (at E2 L2 1930 2100)
  (at E3 L4 1930 2000) (at E3 L3 2000 2010) (at E3 L4 2010 2100))

 ;; (id 持有者 极性 命题 观察时所在地点 [critical])
 (knowledge
  (k1 E2 pos (at E1 L2 1930 2000) L2)
  (k2 E2 neg (at E1 L2 2000 2025) L2 critical)
  (k3 E2 pos (at E1 L2 2025 2100) L2)
  (k4 E3 pos (at E1 L3 2000 2005) L3)
  (k5 E3 pos (at E1 L1 2005 2010) L3 critical)
  (k6 E1 pos (at E3 L3 2000 2005) L3)
  (k7 E1 pos (at E2 L2 1930 2000) L2)
  (k8 E1 pos (at E2 L2 2025 2100) L2))

 ;; (npc 第0层 第1层 ...)，每层是该 NPC 对自己行踪的完整说法
 (cover
  (E1 ((at E1 L2 1930 2100))
      ((at E1 L2 1930 2000) (at E1 L3 2000 2025) (at E1 L2 2025 2100)))
  (E3 ((at E3 L4 1930 2100))))

 ;; (id 名称 所蕴含的命题)
 (evidence
  (EV1 "走廊里的烟头（园丁常抽的牌子）" (at E3 L3 2000 2010))))
